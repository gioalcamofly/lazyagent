{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazyagent/protocol/v1/handshake.json",
  "title": "lazyagent protocol v1 handshake",
  "description": "The first request on a connection is method 'hello'. A protocol mismatch is answered with error UNSUPPORTED_VERSION, data {supported: [int], requested}.",
  "$defs": {
    "hello.params": {
      "type": "object",
      "required": ["protocol", "client"],
      "properties": {
        "protocol": {"type": "integer", "minimum": 1, "description": "Major version the client speaks."},
        "client": {"type": "string", "description": "Client kind: tui, web, mcp or cli. Open set."},
        "client_version": {"type": "string"},
        "token": {"type": "string", "description": "Required over WebSocket, unused on the Unix socket."}
      }
    },
    "hello.result": {
      "type": "object",
      "required": ["protocol", "engine_version", "capabilities", "repo_root", "engine_id"],
      "properties": {
        "protocol": {"type": "integer", "minimum": 1},
        "engine_version": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "repo_root": {"type": "string"},
        "engine_id": {"type": "string"},
        "detached": {"type": "boolean"},
        "source_commit": {"type": ["string", "null"]}
      }
    },
    "unsupported_version.data": {
      "type": "object",
      "required": ["supported"],
      "properties": {
        "supported": {"type": "array", "items": {"type": "integer"}},
        "requested": {}
      }
    }
  }
}
