{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazyagent/protocol/v1/events.json",
  "title": "lazyagent protocol v1 event payloads",
  "description": "Each definition whose name contains a dot is an event name and describes that event's 'data'. Clients ignore events they do not know.",
  "$defs": {
    "git_status": {
      "type": "object",
      "required": ["dirty_count", "ahead", "behind"],
      "properties": {
        "dirty_count": {"type": "integer", "minimum": 0},
        "ahead": {"type": "integer", "minimum": 0},
        "behind": {"type": "integer", "minimum": 0},
        "has_upstream": {"type": "boolean"},
        "last_commit_subject": {"type": "string"}
      }
    },
    "ci_check": {
      "type": "object",
      "required": ["name", "status", "conclusion"],
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string"},
        "conclusion": {"type": "string"},
        "details_url": {"type": "string", "description": "U4: the check's page; empty when GitHub gave none."}
      }
    },
    "pr_info": {
      "type": "object",
      "required": ["number", "title", "state", "checks"],
      "properties": {
        "number": {"type": "integer"},
        "title": {"type": "string"},
        "state": {"type": "string", "description": "OPEN, CLOSED or MERGED"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/ci_check"}},
        "url": {"type": "string"},
        "review_decision": {"type": "string"},
        "mergeable": {"type": "string"},
        "base_ref": {"type": "string", "description": "The branch the PR merges into (baseRefName); empty when unknown."}
      }
    },
    "stream_geometry": {
      "type": "object",
      "description": "Sent only to the connection that owns the stream; 'seq' is then the engine's latest seq, not a new one, and these events are not replayed.",
      "required": ["stream_id", "rows", "cols", "offset"],
      "properties": {
        "stream_id": {"type": "integer", "minimum": 0},
        "session_id": {"type": "string"},
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "offset": {"type": "integer", "minimum": 0, "description": "Output offset at which the change applies."}
      }
    },

    "agent.status": {
      "type": "object",
      "description": "An agent status transition; AgentEvent.to_dict(). 'seq' here is the list_events cursor, distinct from the envelope seq.",
      "required": ["seq", "time", "worktree_path", "agent_id", "label", "status", "previous_status", "detail"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "time": {"type": "number", "description": "Unix wall-clock seconds."},
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "label": {"type": "string"},
        "status": {"anyOf": [{"$ref": "methods.json#/$defs/agent_status"}, {"const": "exited"}]},
        "previous_status": {"anyOf": [{"$ref": "methods.json#/$defs/agent_status"}, {"const": "exited"}]},
        "detail": {"type": "string"}
      }
    },
    "agent.updated": {
      "type": "object",
      "description": "An agent's current state after any change, detail-only ones included. Not in the list_events log (agent.status has the transitions).",
      "required": ["worktree_path", "agent_id", "status", "confidence", "detail"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "status": {"$ref": "methods.json#/$defs/agent_status"},
        "confidence": {"$ref": "methods.json#/$defs/confidence"},
        "detail": {"type": "string"}
      }
    },
    "agent.spawned": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "session_id", "label", "session_name", "kind"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "session_id": {"type": "string"},
        "label": {"type": "string"},
        "session_name": {"type": "string"},
        "kind": {"enum": ["agent", "orchestrator", "shell"]}
      }
    },
    "agent.exited": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "session_id"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "session_id": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "stopped": {"type": "boolean", "description": "True when a client stopped it, false when it exited on its own."}
      }
    },
    "worktrees.changed": {"$ref": "methods.json#/$defs/list_worktrees.result"},
    "git_status.updated": {
      "type": "object",
      "description": "Map of worktree path to its git status.",
      "additionalProperties": {"$ref": "#/$defs/git_status"}
    },
    "pr_info.updated": {
      "type": "object",
      "required": ["path", "pr_info"],
      "properties": {
        "path": {"type": "string"},
        "pr_info": {"anyOf": [{"$ref": "#/$defs/pr_info"}, {"type": "null"}]}
      }
    },
    "stream.resized": {"$ref": "#/$defs/stream_geometry"},
    "stream.reset": {"$ref": "#/$defs/stream_geometry"},
    "stream.closed": {
      "type": "object",
      "description": "The session's PTY is gone (exited or stopped); the stream is detached. Per connection, like stream.resized.",
      "required": ["stream_id", "session_id", "offset"],
      "properties": {
        "stream_id": {"type": "integer", "minimum": 0},
        "session_id": {"type": "string"},
        "offset": {"type": "integer", "minimum": 0, "description": "Offset after the last output byte."},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "engine.notice": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": {"enum": ["information", "warning", "error"]},
        "message": {"type": "string"}
      }
    },
    "job.started": {
      "type": "object",
      "required": ["job_id", "title", "command"],
      "properties": {
        "job_id": {"type": "string"},
        "title": {"type": "string", "description": "What the job is for, for display."},
        "command": {"type": "string"}
      }
    },
    "job.output": {
      "type": "object",
      "required": ["job_id", "text"],
      "properties": {
        "job_id": {"type": "string"},
        "text": {"type": "string", "description": "Output chunk, UTF-8 decoded with replacement."}
      }
    },
    "job.finished": {
      "type": "object",
      "required": ["job_id", "exit_code"],
      "properties": {
        "job_id": {"type": "string"},
        "exit_code": {"type": ["integer", "null"], "description": "null when the job was killed by a signal."}
      }
    },
    "restorable.changed": {
      "$ref": "methods.json#/$defs/list_restorable.result",
      "description": "The restorable list changed without a restore: an entry became live in this engine (spawned into its slot or resuming its conversation) and was consumed, was hidden or shown again, or was dismissed. agents: what list_restorable answers now."
    },
    "notes.updated": {
      "type": "object",
      "description": "An agent's session notes were written (proposal 0011). Fetch the text with notes_get when it is shown.",
      "required": ["worktree_path", "agent_id", "notes_id", "rev", "size", "by"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "notes_id": {"type": "string"},
        "rev": {"type": "integer", "description": "+1 per write; a write with a stale if_rev is refused."},
        "size": {"type": "integer", "description": "UTF-8 bytes of the text."},
        "by": {"type": "string", "x-known-values": ["user", "agent", "orchestrator"]}
      }
    },
    "notes.removed": {
      "type": "object",
      "description": "Notes stopped being an agent's live notes, or were deleted. orphaned: the agent ended without a stop; the file is kept (orphan_days) and can be adopted.",
      "required": ["notes_id", "worktree_path", "agent_id", "reason"],
      "properties": {
        "notes_id": {"type": "string"},
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "reason": {"type": "string", "x-known-values": ["deleted", "orphaned", "adopted", "pruned"], "description": "deleted: on purpose (stop, dismiss, a client); pruned: by the GC (only the latest per worktree, orphan expiry, worktree gone, a fresh agent)."}
      }
    },
    "engine.restored": {
      "type": "object",
      "description": "What a restore_agents brought back and what failed (a failed agent stays restorable).",
      "required": ["restored", "failed"],
      "properties": {
        "restored": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "worktree_path", "agent_id", "session_id", "label", "session_name", "kind", "resumed"],
            "properties": {
              "id": {"type": "string"},
              "worktree_path": {"type": "string"},
              "agent_id": {"type": "string"},
              "session_id": {"type": "string"},
              "label": {"type": "string"},
              "session_name": {"type": "string"},
              "kind": {"type": "string", "x-known-values": ["agent", "orchestrator"]},
              "resumed": {"type": "string", "x-known-values": ["conversation", "last"], "description": "conversation: the exact one its provider reported; last: the provider's last conversation in that directory."}
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason"],
            "properties": {
              "id": {"type": "string"},
              "worktree_path": {"type": "string"},
              "agent_id": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "engine.shutdown": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string"}
      }
    },
    "ui_command_name": {
      "type": "string",
      "description": "Open set: a hosted UI ignores a command it does not know.",
      "x-known-values": ["select_worktree", "select_orchestrator", "focus_agent", "open_shell", "show_diff", "open_modal", "blank"]
    },
    "ui.command": {
      "type": "object",
      "required": ["command", "worktree_path"],
      "properties": {
        "command": {"$ref": "#/$defs/ui_command_name"},
        "worktree_path": {"type": ["string", "null"], "description": "The resolved target; null is the orchestrator."},
        "agent_id": {"type": ["string", "null"], "description": "focus_agent: the agent, or null for the active one."},
        "modal": {"type": "string", "description": "open_modal: spawn, create or remove."}
      }
    },
    "ui.view_changed": {"$ref": "methods.json#/$defs/ui_view"}
  }
}
