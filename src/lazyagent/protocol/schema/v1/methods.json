{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazyagent/protocol/v1/methods.json",
  "title": "lazyagent protocol v1 method params and results",
  "description": "Definitions named '<method>.params' and '<method>.result': the ten methods inherited from the legacy IPC server, then the v1 additions. Fields marked 'v1' are additions the legacy server does not send.",
  "$defs": {
    "agent_status": {
      "type": "string",
      "description": "Open set: clients must tolerate values they do not know.",
      "x-known-values": ["no_agent", "starting", "running", "waiting", "waiting_for_user", "waiting_for_approval", "completed", "failed", "interrupted", "possibly_hanged"]
    },
    "confidence": {
      "type": "string",
      "description": "Open set: clients must tolerate values they do not know.",
      "x-known-values": ["high", "medium", "low"]
    },
    "worktree_path": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "description": "Optional selector: may be omitted when the worktree has exactly one agent."},
    "git_status": {
      "type": "object",
      "required": ["dirty_count", "ahead", "behind"],
      "properties": {
        "dirty_count": {"type": "integer", "minimum": 0},
        "ahead": {"type": "integer", "minimum": 0},
        "behind": {"type": "integer", "minimum": 0}
      }
    },
    "agent": {
      "type": "object",
      "required": ["agent_id", "label", "session_name", "status", "confidence", "detail"],
      "properties": {
        "agent_id": {"type": "string"},
        "label": {"type": "string"},
        "session_name": {"type": "string"},
        "status": {"$ref": "#/$defs/agent_status"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "detail": {"type": "string"},
        "session_id": {"type": "string", "description": "v1"},
        "kind": {"enum": ["agent", "orchestrator"], "description": "v1"},
        "size": {
          "type": "object",
          "description": "v1: current PTY size",
          "required": ["rows", "cols"],
          "properties": {
            "rows": {"type": "integer", "minimum": 1},
            "cols": {"type": "integer", "minimum": 1}
          }
        },
        "attached_clients": {"type": "integer", "minimum": 0, "description": "v1"}
      }
    },
    "worktree": {
      "type": "object",
      "required": ["path", "branch", "head", "is_main", "is_bare", "agent_status", "agents"],
      "properties": {
        "path": {"type": "string"},
        "branch": {"type": ["string", "null"], "description": "null for a detached HEAD"},
        "head": {"type": "string"},
        "is_main": {"type": "boolean"},
        "is_bare": {"type": "boolean"},
        "agent_status": {"$ref": "#/$defs/agent_status", "description": "Roll-up over agents, kept for back-compat."},
        "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
        "git_status": {"$ref": "#/$defs/git_status", "description": "Present once the status has been computed."}
      }
    },

    "list_worktrees.params": {"type": "object", "properties": {}},
    "list_worktrees.result": {"type": "array", "items": {"$ref": "#/$defs/worktree"}},

    "create_worktree.params": {
      "type": "object",
      "required": ["branch"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "base_branch": {"type": "string", "default": "main"},
        "extra": {"type": "string", "description": "Only used by a configured custom create command."},
        "env": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Environment of a custom command this call runs (the client's, D5); the engine's own when omitted."}
      }
    },
    "create_worktree.result": {
      "type": "object",
      "required": ["path", "branch"],
      "properties": {
        "path": {"type": "string"},
        "branch": {"type": "string"},
        "custom_command": {"type": "boolean", "description": "True when a custom create command ran; path is then predicted."},
        "warning": {"type": "string"},
        "job_id": {"type": "string", "description": "v1: custom create runs as an engine job (job.output / job.finished)."}
      }
    },

    "remove_worktree.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "force": {"type": "boolean", "default": false},
        "custom": {"type": "boolean", "default": false, "description": "Run the configured custom remove command as an engine job instead of git worktree remove, as the TUI does."},
        "env": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Environment of a custom command this call runs (the client's, D5); the engine's own when omitted."}
      }
    },
    "remove_worktree.result": {
      "type": "object",
      "required": ["removed"],
      "properties": {
        "removed": {"type": "string"},
        "job_id": {"type": "string", "description": "v1: custom remove runs as an engine job."}
      }
    },

    "spawn_agent.params": {
      "type": "object",
      "description": "worktree_path is required for kind 'agent' and ignored for 'orchestrator'.",
      "properties": {
        "worktree_path": {"type": "string"},
        "instruction": {"type": ["string", "null"]},
        "initial_prompt": {"type": ["string", "null"], "description": "Deprecated alias of instruction."},
        "skip_permissions": {"type": "boolean", "default": true},
        "label": {"type": ["string", "null"]},
        "resume_mode": {"enum": ["new", "pick", "last"], "default": "new"},
        "kind": {"enum": ["agent", "orchestrator"], "default": "agent", "description": "v1"},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "v1: environment of the calling client; the agent inherits it."
        }
      }
    },
    "spawn_agent.result": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "status", "cursor"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "status": {"const": "spawned"},
        "cursor": {"type": "integer", "minimum": 0, "description": "list_events cursor taken before the spawn."},
        "session_id": {"type": "string", "description": "v1"}
      }
    },

    "stop_agent.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "agent_id": {"$ref": "#/$defs/agent_id"}
      }
    },
    "stop_agent.result": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "status"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "status": {"const": "stopped"}
      }
    },

    "get_agent_status.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "agent_id": {"$ref": "#/$defs/agent_id"}
      }
    },
    "get_agent_status.result": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "status", "detail"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string", "description": "Empty when status is no_agent."},
        "status": {"$ref": "#/$defs/agent_status"},
        "confidence": {"$ref": "#/$defs/confidence", "description": "Absent when status is no_agent."},
        "detail": {"type": "string"}
      }
    },

    "read_agent_output.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "agent_id": {"$ref": "#/$defs/agent_id"},
        "lines": {"type": "integer", "minimum": 0, "default": 50}
      }
    },
    "read_agent_output.result": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "lines", "total_lines"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "lines": {"type": "array", "items": {"type": "string"}, "description": "Oldest first."},
        "total_lines": {"type": "integer", "minimum": 0}
      }
    },

    "send_agent_input.params": {
      "type": "object",
      "required": ["worktree_path", "text"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "text": {"type": "string", "minLength": 1},
        "agent_id": {"$ref": "#/$defs/agent_id"},
        "confirm": {"type": "boolean", "default": true}
      }
    },
    "send_agent_input.result": {
      "type": "object",
      "required": ["worktree_path", "agent_id", "status", "status_before", "cursor", "delivery"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agent_id": {"type": "string"},
        "status": {"const": "sent"},
        "status_before": {"$ref": "#/$defs/agent_status"},
        "cursor": {"type": "integer", "minimum": 0},
        "delivery": {"type": "string", "description": "Open set: clients must tolerate values they do not know.", "x-known-values": ["confirmed", "unconfirmed", "busy", "unchecked"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },

    "list_agents.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"}
      }
    },
    "list_agents.result": {
      "type": "object",
      "required": ["worktree_path", "agents"],
      "properties": {
        "worktree_path": {"type": "string"},
        "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}}
      }
    },

    "size": {
      "type": "object",
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "session_id": {"type": "string", "minLength": 1},
    "worktree_paths": {"type": "array", "items": {"type": "string"}},

    "subscribe.params": {
      "type": "object",
      "properties": {
        "since": {"type": ["integer", "null"], "minimum": 0, "description": "Replay the events after this seq first; omitted or null means from now."},
        "events": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Only these event names; omitted or null means all. A later subscribe replaces the filter."}
      }
    },
    "subscribe.result": {
      "type": "object",
      "required": ["cursor", "replayed", "truncated"],
      "properties": {
        "cursor": {"type": "integer", "minimum": 0, "description": "seq of the newest event when the subscription started; live events are after it."},
        "replayed": {"type": "integer", "minimum": 0, "description": "How many history events follow the response, before the live ones."},
        "truncated": {"type": "boolean", "description": "True when events after since were already evicted from the history."}
      }
    },
    "unsubscribe.params": {"type": "object", "properties": {}},
    "unsubscribe.result": {
      "type": "object",
      "required": ["unsubscribed"],
      "properties": {
        "unsubscribed": {"type": "boolean", "description": "False when there was no subscription."}
      }
    },

    "attach_stream.params": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": {"$ref": "#/$defs/session_id"},
        "from_offset": {"type": ["integer", "null"], "minimum": 0, "description": "Resume point: offset after the last byte the client has."}
      }
    },
    "attach_stream.result": {
      "type": "object",
      "required": ["stream_id", "session_id", "size", "mode", "offset"],
      "properties": {
        "stream_id": {"type": "integer", "minimum": 1, "description": "Per connection; output and input frames carry it."},
        "session_id": {"type": "string"},
        "size": {"$ref": "#/$defs/size"},
        "mode": {"enum": ["snapshot", "tail"], "description": "tail: output frames resume at from_offset. snapshot: render 'snapshot' into an empty terminal of 'size', then the output frames from 'offset'."},
        "offset": {"type": "integer", "minimum": 0, "description": "Offset of the first output frame that follows."},
        "snapshot": {"type": "string", "description": "mode snapshot only: ANSI that rebuilds the screen and capped scrollback as of 'offset'."}
      }
    },
    "detach_stream.params": {
      "type": "object",
      "required": ["stream_id"],
      "properties": {
        "stream_id": {"type": "integer", "minimum": 1}
      }
    },
    "detach_stream.result": {
      "type": "object",
      "required": ["stream_id", "detached"],
      "properties": {
        "stream_id": {"type": "integer"},
        "detached": {"const": true}
      }
    },

    "resize.params": {
      "type": "object",
      "required": ["session_id", "rows", "cols"],
      "properties": {
        "session_id": {"$ref": "#/$defs/session_id"},
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "resize.result": {"$ref": "#/$defs/size_owner"},
    "claim_size.params": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": {"$ref": "#/$defs/session_id"},
        "rows": {"type": "integer", "minimum": 1, "description": "With cols: claim and resize in one step."},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "claim_size.result": {"$ref": "#/$defs/size_owner"},
    "size_owner": {
      "type": "object",
      "required": ["session_id", "rows", "cols", "owner"],
      "properties": {
        "session_id": {"type": "string"},
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "owner": {"type": "boolean", "description": "Whether the caller owns the session's size."}
      }
    },

    "open_shell.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Environment of a shell started by this call; ignored when it already runs."
        }
      }
    },
    "open_shell.result": {
      "type": "object",
      "required": ["worktree_path", "session_id", "size"],
      "properties": {
        "worktree_path": {"type": "string"},
        "session_id": {"type": "string"},
        "size": {"$ref": "#/$defs/size"}
      }
    },

    "refresh_worktrees.params": {"type": "object", "properties": {}},
    "refresh_worktrees.result": {"$ref": "#/$defs/list_worktrees.result"},
    "refresh_git_status.params": {
      "type": "object",
      "properties": {
        "paths": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Omitted or null means every worktree."}
      }
    },
    "refresh_git_status.result": {
      "type": "object",
      "required": ["statuses"],
      "properties": {
        "statuses": {"$ref": "events.json#/$defs/git_status.updated"}
      }
    },
    "get_diff.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "base": {"type": "string", "minLength": 1, "description": "U5: diff from the merge-base of this branch (or commit) and HEAD to the working tree, so committed work shows too. VALIDATION_ERROR when there is no merge-base. Default: the working tree against the index, as the TUI's tab."},
        "max_bytes": {"type": "integer", "minimum": 1, "description": "U5: the cap instead of the default 64 KiB, up to 4 MiB (4194304); more is a VALIDATION_ERROR."}
      }
    },
    "get_diff.result": {
      "type": "object",
      "required": ["worktree_path", "diff"],
      "properties": {
        "worktree_path": {"type": "string"},
        "diff": {"type": "string", "description": "Capped like the TUI's diff tab."}
      }
    },
    "get_pr_info.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path"},
        "refresh": {"type": "boolean", "default": false, "description": "Fetch even when a cached answer exists."}
      }
    },
    "get_pr_info.result": {
      "type": "object",
      "required": ["worktree_path", "pr_info", "fetched"],
      "properties": {
        "worktree_path": {"type": "string"},
        "pr_info": {"anyOf": [{"$ref": "events.json#/$defs/pr_info"}, {"type": "null"}]},
        "fetched": {"type": "boolean", "description": "False when no answer could be fetched (no gh); pr_info is then null."}
      }
    },
    "set_interest.params": {
      "type": "object",
      "required": ["worktree_paths"],
      "properties": {
        "worktree_paths": {"$ref": "#/$defs/worktree_paths"}
      }
    },
    "set_interest.result": {
      "type": "object",
      "required": ["worktree_paths", "interest"],
      "properties": {
        "worktree_paths": {"$ref": "#/$defs/worktree_paths", "description": "This client's interest set."},
        "interest": {"$ref": "#/$defs/worktree_paths", "description": "The union over every client, which the pollers use."}
      }
    },
    "get_config.params": {"type": "object", "properties": {}},
    "get_config.result": {
      "type": "object",
      "required": ["agent_provider", "default_branch", "has_custom_create", "has_custom_remove"],
      "properties": {
        "agent_provider": {"type": "string"},
        "default_branch": {"type": "string"},
        "has_custom_create": {"type": "boolean"},
        "has_custom_remove": {"type": "boolean"}
      }
    },

    "get_sidebar_state.params": {"type": "object", "properties": {}},
    "get_sidebar_state.result": {
      "type": "object",
      "required": ["worktrees", "orchestrator", "pr_info", "view", "cursor"],
      "properties": {
        "worktrees": {"$ref": "#/$defs/list_worktrees.result"},
        "orchestrator": {
          "type": "object",
          "required": ["agents"],
          "properties": {
            "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}, "description": "Empty or the one orchestrator agent (agent_id \"\")."}
          }
        },
        "pr_info": {
          "type": "object",
          "additionalProperties": {"anyOf": [{"$ref": "events.json#/$defs/pr_info"}, {"type": "null"}]},
          "description": "Worktree path -> PR info (null: no PR), for the worktrees fetched so far."
        },
        "git_statuses": {"$ref": "events.json#/$defs/git_status.updated", "description": "Worktree path -> full git status, for the worktrees computed so far (worktrees only carries the counts)."},
        "view": {"anyOf": [{"$ref": "#/$defs/ui_view"}, {"type": "null"}]},
        "cursor": {"type": "integer", "minimum": 0, "description": "subscribe {since: cursor} continues from this state without a gap."}
      }
    },

    "ui_view": {
      "type": "object",
      "required": ["worktree_path", "orchestrator", "agent_id", "focus", "modal"],
      "properties": {
        "worktree_path": {"type": ["string", "null"], "description": "The worktree shown; null when the orchestrator or nothing is."},
        "orchestrator": {"type": "boolean"},
        "agent_id": {"type": ["string", "null"], "description": "The agent whose terminal is the active tab (the orchestrator's is \"\"); null when none is."},
        "focus": {
          "type": "string",
          "description": "Open set: clients must tolerate values they do not know.",
          "x-known-values": ["agent", "shell", "diff", "sidebar", "modal", "none"]
        },
        "modal": {"type": ["string", "null"], "description": "The open modal (spawn, create, remove, help, …) while focus is modal; else null."}
      }
    },
    "ui_command": {
      "type": "object",
      "required": ["seq", "command", "worktree_path"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0, "description": "seq of the ui.command event the hosted UI acts on."},
        "command": {"$ref": "events.json#/$defs/ui_command_name"},
        "worktree_path": {"type": ["string", "null"], "description": "The resolved target; null is the orchestrator."},
        "agent_id": {"type": ["string", "null"]},
        "modal": {"type": "string"}
      }
    },
    "ui_target": {"type": "boolean", "description": "true targets the orchestrator instead of a worktree."},
    "attach_ui.params": {"type": "object", "properties": {}, "description": "Make this connection a hosted UI (a TUI on a remote engine): the ui.* commands are offered while one is attached. Dropped by detach_ui or on disconnect."},
    "attach_ui.result": {"type": "object", "required": ["attached"], "properties": {"attached": {"const": true}}},
    "detach_ui.params": {"type": "object", "properties": {}},
    "detach_ui.result": {"type": "object", "required": ["attached"], "properties": {"attached": {"const": false}}},
    "publish_view.params": {
      "type": "object",
      "required": ["view"],
      "description": "A UI announces what it shows; emitted as ui.view_changed unless equal to the last view.",
      "properties": {"view": {"$ref": "#/$defs/ui_view"}}
    },
    "publish_view.result": {
      "type": "object",
      "required": ["published"],
      "properties": {"published": {"type": "boolean", "description": "False when the view equals the last one announced."}}
    },
    "shutdown.params": {
      "type": "object",
      "description": "Stop a detached engine once the reply is sent (lazyagent engine stop). An engine inside a TUI answers VALIDATION_ERROR.",
      "properties": {
        "stop_agents": {"type": "boolean", "default": true, "description": "false: only stop an engine that runs no agent (VALIDATION_ERROR otherwise). An agent cannot outlive its engine: its PTY closes."}
      }
    },
    "shutdown.result": {
      "type": "object",
      "required": ["stopping", "agents"],
      "properties": {
        "stopping": {"const": true},
        "agents": {"type": "integer", "minimum": 0, "description": "Agents (the orchestrator included) stopped with the engine."}
      }
    },
    "restorable_agent": {
      "type": "object",
      "description": "An agent an earlier engine ran when it ended, from the restart manifest.",
      "required": ["id", "worktree_path", "agent_id", "kind", "provider", "label", "session_name", "skip_permissions", "conversation_id", "instruction", "started_at", "engine_id", "ended_at"],
      "properties": {
        "id": {"type": "string", "description": "Opaque; what restore_agents and dismiss_restorable take."},
        "worktree_path": {"type": "string", "description": "The orchestrator's key for kind orchestrator."},
        "agent_id": {"type": "string"},
        "kind": {"type": "string", "x-known-values": ["agent", "orchestrator"]},
        "provider": {"type": "string"},
        "label": {"type": "string"},
        "session_name": {"type": "string"},
        "skip_permissions": {"type": "boolean"},
        "conversation_id": {"type": ["string", "null"], "description": "The provider's conversation id when it reported one; a restore resumes exactly it, else the provider's last conversation."},
        "instruction": {"type": ["string", "null"], "description": "The last instruction sent to it, when known (first 4,096 characters)."},
        "started_at": {"type": "number"},
        "engine_id": {"type": ["string", "null"]},
        "ended_at": {"type": ["number", "null"]}
      }
    },
    "restore_ids": {"type": "array", "items": {"type": "string"}, "description": "Default: every restorable agent."},
    "list_restorable.params": {"type": "object", "properties": {}},
    "list_restorable.result": {
      "type": "object",
      "required": ["agents"],
      "properties": {"agents": {"type": "array", "items": {"$ref": "#/$defs/restorable_agent"}}}
    },
    "restore_agents.params": {
      "type": "object",
      "properties": {
        "ids": {"$ref": "#/$defs/restore_ids"},
        "env": {"type": "object", "additionalProperties": {"type": "string"}, "description": "The environment the agents start from (the calling client's, D5); default: the engine's."}
      }
    },
    "restore_agents.result": {"$ref": "events.json#/$defs/engine.restored"},
    "dismiss_restorable.params": {"type": "object", "properties": {"ids": {"$ref": "#/$defs/restore_ids"}}},
    "dismiss_restorable.result": {
      "type": "object",
      "required": ["dismissed"],
      "properties": {"dismissed": {"type": "array", "items": {"type": "string"}}}
    },
    "ui.get_view.params": {"type": "object", "properties": {}},
    "ui.get_view.result": {
      "type": "object",
      "required": ["view"],
      "properties": {
        "view": {"anyOf": [{"$ref": "#/$defs/ui_view"}, {"type": "null"}], "description": "null until a UI has announced one."}
      }
    },
    "ui.select_worktree.params": {
      "type": "object",
      "required": ["worktree_path"],
      "properties": {"worktree_path": {"$ref": "#/$defs/worktree_path"}}
    },
    "ui.select_worktree.result": {"$ref": "#/$defs/ui_command"},
    "ui.select_orchestrator.params": {"type": "object", "properties": {}},
    "ui.select_orchestrator.result": {"$ref": "#/$defs/ui_command"},
    "ui.focus_agent.params": {
      "type": "object",
      "properties": {
        "worktree_path": {"$ref": "#/$defs/worktree_path", "description": "Default: the worktree the UI shows."},
        "orchestrator": {"$ref": "#/$defs/ui_target"},
        "agent_id": {"type": "string", "description": "Omitted: the active agent tab, or the last one."}
      }
    },
    "ui.focus_agent.result": {"$ref": "#/$defs/ui_command"},
    "ui.open_shell.params": {
      "type": "object",
      "properties": {"worktree_path": {"$ref": "#/$defs/worktree_path", "description": "Default: the worktree the UI shows."}}
    },
    "ui.open_shell.result": {"$ref": "#/$defs/ui_command"},
    "ui.show_diff.params": {
      "type": "object",
      "properties": {"worktree_path": {"$ref": "#/$defs/worktree_path", "description": "Default: the worktree the UI shows."}}
    },
    "ui.show_diff.result": {"$ref": "#/$defs/ui_command"},
    "ui.blank.params": {"type": "object", "properties": {}, "description": "The hosted UI shows no worktree (a placeholder) until the next ui command, so it renders no agent: a host that shows the agents natively sends it while the hosted UI is out of sight."},
    "ui.blank.result": {"$ref": "#/$defs/ui_command"},
    "ui.open_modal.params": {
      "type": "object",
      "required": ["modal"],
      "properties": {
        "modal": {"enum": ["spawn", "create", "remove"]},
        "worktree_path": {"$ref": "#/$defs/worktree_path", "description": "Default: the worktree the UI shows. create ignores it and answers worktree_path null."},
        "orchestrator": {"$ref": "#/$defs/ui_target"}
      }
    },
    "ui.open_modal.result": {"$ref": "#/$defs/ui_command"},

    "list_events.params": {
      "type": "object",
      "properties": {
        "since": {"type": ["integer", "null"], "minimum": 0, "description": "Cursor; omitted or null means from now."},
        "worktree_path": {"type": ["string", "null"]},
        "agent_id": {"type": ["string", "null"]},
        "statuses": {
          "anyOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}},
            {"type": "null"}
          ],
          "description": "Status values or group names (idle, blocked, finished, not_running)."
        }
      }
    },
    "list_events.result": {
      "type": "object",
      "required": ["events", "cursor", "truncated"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "events.json#/$defs/agent.status"}},
        "cursor": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean", "description": "True when events after since were already evicted."},
        "restores": {
          "type": "array",
          "description": "Present only when agents were restored after since: each engine.restored, with its seq. Engine-wide: the filters do not apply.",
          "items": {
            "type": "object",
            "required": ["seq", "restored", "failed"],
            "properties": {
              "seq": {"type": "integer", "minimum": 1},
              "restored": {"$ref": "events.json#/$defs/engine.restored/properties/restored"},
              "failed": {"$ref": "events.json#/$defs/engine.restored/properties/failed"}
            }
          }
        }
      }
    }
  }
}
